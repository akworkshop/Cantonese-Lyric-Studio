# 您可以在網頁頂部的「AI 引擎設定列」直接輸入 API Key（自動保存在瀏覽器 localStorage），
# 或複製此檔案為 .env.local 並在下方填入：

GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Supabase 雲端專案同步與會員系統 (可選)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google 原生 One Tap / Identity Services 登入 (可選，提供零跳轉原生秒登體驗)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
